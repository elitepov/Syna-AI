# ── Telegram ──────────────────────────────────────────────
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# ── Google Gemini ─────────────────────────────────────────
# Get your API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model to use.
# Free-tier recommended options (no billing required):
#   gemini-2.5-flash        ← best balance of quality + speed (recommended)
#   gemini-2.5-flash-lite   ← fastest and cheapest option
#   gemini-2.5-pro          ← most capable, but lower free-tier rate limits
GEMINI_MODEL=gemini-3.5-flash-lite
